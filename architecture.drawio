        <mxCell id="20" value="2. Socle data &amp; MLOps découplé sur Azure hors Fabric (France Central, conteneurs Docker / Terraform)" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#334155;fontColor=#0f172a;fontSize=13;fontStyle=1;pointerEvents=0;html=1;" vertex="1" parent="1">
