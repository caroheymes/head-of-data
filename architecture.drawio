        <mxCell id="14" value="Esker &amp; Cegid&#xa;(factures achats F&amp;B, fluides&#xa;énergie &amp; comptabilité 7 pays)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="10">
