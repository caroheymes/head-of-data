        </mxCell>

        <mxCell id="21" value="Sas Python dlt conteneurisé&#xa;Hachage salé SHA-256 en mémoire&#xa;(exclusion nominatif &amp; art. 9 RGPD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="30" y="60" width="205" height="110" as="geometry" />
        </mxCell>

        <mxCell id="22" value="Apache Airflow (Container Apps)&#xa;DAGs 15 min (CRM/Lxxxx), quotidiens&#xa;ERP &amp; alertes webhooks Teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="30" y="210" width="205" height="115" as="geometry" />
        </mxCell>

        <mxCell id="23" value="Schémas transactionnels PostgreSQL&#xa;(app_ops.biowaste_entry &amp; seuils&#xa;CRM/wash, écritures idempotentes)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="30" y="365" width="205" height="120" as="geometry" />
        </mxCell>

        <mxCell id="24" value="PostgreSQL schémas Bronze&#xa;Brut haché append-only&#xa;(purge sas temporaire &lt;= 30 j)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1e293b;fontSize=11;" vertex="1" parent="20">
          <mxGeometry x="280" y="60" width="215" height="110" as="geometry" />
        </mxCell>

        <mxCell id="25" value="PostgreSQL Silver (dbt Core)&#xa;Compte B2B unifié (SIREN/TVA),&#xa;jauges &amp; facteurs carbone versionnés" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="280" y="210" width="215" height="115" as="geometry" />
        </mxCell>

        <mxCell id="26" value="PostgreSQL Gold (3 domaines)&#xa;Vues contrats SQL en lecture seule&#xa;(Séminaires, Événementiel, In-Situ &amp; CA)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="280" y="365" width="215" height="120" as="geometry" />
        </mxCell>

        <mxCell id="27" value="Usine MLOps conteneurisée&#xa;Pandas &amp; scikit-learn (baseline&#xa;puis modèle) + registre MLflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="540" y="60" width="195" height="115" as="geometry" />
        </mxCell>

        <mxCell id="28" value="Data lineage OpenLineage&#xa;Graphe à la colonne (Airflow + dbt)&#xa;Catalogue open source ou SaaS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="540" y="210" width="195" height="115" as="geometry" />
        </mxCell>

        <mxCell id="29" value="Micro-services FastAPI&#xa;Matching CRM, saisie biodéchets&#xa;&amp; certificats PDF/JSON (scope 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="540" y="365" width="195" height="120" as="geometry" />
        </mxCell>

        <mxCell id="30" value="Vitrine Power BI / TMDL&#xa;Lecture seule Gold (équipe BI)&#xa;Option 3 -&gt; arbitrage Option 1 S19" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="770" y="210" width="165" height="115" as="geometry" />
        </mxCell>

        <mxCell id="31" value="Ingress Container Apps&#xa;TLS 1.3, SSO OAuth2 Entra ID&#xa;&amp; quotas NIS2 (zéro coût APIM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="770" y="365" width="165" height="120" as="geometry" />
        </mxCell>

        <mxCell id="32" value="Socle transverse Gouvernance, Sécurité, MLOps &amp; Sobriété FinOps (zéro Spark, portabilité Docker complète)&#xa;RLS symétrique PostgreSQL + TMDL Entra ID par site, pays et Contrat In-Situ (NIS2 art. 21) | Lignage à la colonne OpenLineage &amp; Git dbt (opposable OTI &amp; CSRD)&#xa;FinOps: socle PostgreSQL + Container Apps ~340 à 405 € HT/mois (~650 à 700 € vitrine BI incluse, soit 8 fois moins que Fabric F64 + APIM) | AI Act art. 50 &amp; verrou J-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="20">
          <mxGeometry x="30" y="535" width="905" height="135" as="geometry" />
        </mxCell>

        <mxCell id="40" value="3. Surfaces d'usage terrain &amp; 3 POC (greffe légère)" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;fontSize=13;fontStyle=1;pointerEvents=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="90" width="380" height="710" as="geometry" />
        </mxCell>

        <mxCell id="41" value="POC 1 (semaines 1 à 6): commercial &amp; options&#xa;Composant PCF Dynamics 365 sur FastAPI (Copilot)&#xa;3 sites de repli + bascule Événementiel (&gt; 250 pers.)&#xa;File matinale des Options de rang 1 à risque" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="40">
          <mxGeometry x="25" y="60" width="330" height="155" as="geometry" />
        </mxCell>

        <mxCell id="42" value="POC 2 (semaines 7 à 13): attrition wash &amp; marge&#xa;Rapports Power BI + alertes webhooks Teams J-14 / J-5&#xa;Baseline puis modèle calibré (frais F&amp;B &amp; Skello)&#xa;Contrôle marge Traiteur + app Streamlit biodéchets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="40">
          <mxGeometry x="25" y="255" width="330" height="175" as="geometry" />
        </mxCell>

        <mxCell id="43" value="POC 3 (semaines 14 à 19): carbone &amp; CSRD scope 3&#xa;Comparateur carbone prévisionnel intégré au devis&#xa;Certificat scope 3 (cat. 3.1 &amp; 3.6) PDF/JSON à J+5&#xa;Dépôt CRM, portail grands comptes &amp; arbitrage FinOps S19" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e293b;fontSize=11;fontStyle=1;" vertex="1" parent="40">
          <mxGeometry x="25" y="470" width="330" height="175" as="geometry" />
