        <mxCell id="16" value="Base Empreinte ADEME,&#xa;facteurs électriques AIE par pays&#xa;&amp; référentiel SaaS bilan carbone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1e293b;fontSize=11;" vertex="1" parent="10">
          <mxGeometry x="20" y="575" width="260" height="80" as="geometry" />
