        <mxCell id="2" value="Architecture découplée Azure hors Fabric du groupe X (micro-services, MLOps &amp; vitrine Power BI, vague 1: 19 semaines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=8;" vertex="1" parent="1">
